# The browser app works without an API server. Leave API settings unset for the bundled frontend-only experience.
# REACT_APP_API_URL=http://localhost:8000/api/v1
# REACT_APP_WS_URL=ws://localhost:8000/ws

# Optional higher-resolution Mars terrain provider for Cesium (quantized-mesh or heightmap).
# Bundled NASA MOLA MEGDR is the default when this is empty.
# NASA Mars Trek imagery, WMS, WMTS, and hillshade URLs are images, not elevation providers.
# REACT_APP_MARS_TERRAIN_URL=https://your-server.example/mars-terrain

# Optional GLB/glTF rover model override. The bundled NASA Curiosity model is the default.
# REACT_APP_MARS_ROVER_MODEL_URL=https://your-server.example/rover.glb

# Optional USGS geology WMS endpoint; WMS layer names may be comma-separated.
# REACT_APP_USGS_MARS_GEOLOGY_WMS_URL=
# REACT_APP_USGS_MARS_GEOLOGY_WMS_LAYERS=
